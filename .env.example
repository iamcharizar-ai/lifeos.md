# Supabase wiring (8pm setup) — copy this file to .env.local and fill in from
# Supabase Dashboard → Project Settings → API. Then restart `npm run dev`.
# Without these the app runs pure-local (localStorage only; the notes-vault write-back was removed).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-side only (never a VITE_ name: that would put it in the browser bundle). Used by `npm run health` here and
# as SUPABASE_SERVICE_ROLE_KEY in the Vercel project for api/health-*. Dashboard -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Linked apps. Set these to each app's deployed URL for production builds; in dev they default to
# the local servers (Pokedex :5190, Woodshed :5180). Left empty in production, the links are hidden.
VITE_POKEDEX_URL=
VITE_WOODSHED_URL=

# The key to the AI links (/api/ai/<token> and /api/mcp/<token>, docs/AI-ACCESS.md). Server-side only, never a VITE_ name.
# 24+ characters or the feature stays shut. Make one: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Set it in the Life OS Vercel project (Production), redeploy, then `npm run ai:links` prints the links. Rotating it cuts every old link off.
AI_SNAPSHOT_TOKEN=
